{
  "name": "payable-edge-gateway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "sim": "esbuild scripts/simulate.ts --bundle --platform=node --format=esm --external:wrangler --outfile=.sim/simulate.mjs --log-level=warning && node .sim/simulate.mjs",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=reports/tests.json && cd web && npx vitest run --reporter=default --reporter=json --outputFile=../reports/web-tests.json",
    "report": "esbuild scripts/report.ts --bundle --platform=node --format=esm --outfile=.sim/report.mjs --log-level=warning && node .sim/report.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.20.5",
    "@vitest/runner": "^4.1.0",
    "@vitest/snapshot": "^4.1.0",
    "fast-check": "^3.22.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}